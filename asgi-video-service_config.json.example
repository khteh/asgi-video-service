# Copy this file to /etc/asgi-video-service_config.json and adjust as needed. All values shown are the
# built-in defaults unless noted otherwise.
{
        "ENVIRONMENT": "development",
        "DEBUG": true,
        "TESTING": false,
        "LOGLEVEL": "DEBUG",
        "SECRET_KEY": "ASGIVideoService",
        "OUTPUT_DIR": "output",
        "GENERATION_PROVIDER": "simulated",
        "MAX_VIDEO_SECONDS": 90,
        "VIDEO_WIDTH": 3840,
        "VIDEO_HEIGHT": 2160,
        "VIDEO_FPS": 60,
        "NVENC_MODE": "auto", 
        "TTS_VOICE": "en-US-AriaNeural",
        "AI_VIDEO_TIMEOUT_SECONDS": 10,
        "LLM_VALIDATION_MODEL": "claude-3-5-haiku-latest",
        "WORKER_CONCURRENCY": 10,
        "MAX_JOB_ATTEMPTS": 3,
        "FFMPEG_TIMEOUT_SECONDS": 120.0,
        "FFPROBE_TIMEOUT_SECONDS": 30,
        "TTS_TIMEOUT_SECONDS": 30
}
# --- Generation ---
# "simulated" (offline, free, default) or "ai" (real provider, needs
# AI_VIDEO_API_KEY below).

# Hard constraints applied to every generated video.

# NVIDIA hardware-accelerated encoding: "auto" probes ffmpeg for a usable
# h264_nvenc encoder and falls back to libx264 if none is found (e.g. no
# GPU present). Set "on" to force NVENC, "off" to force software encoding.

# edge-tts voice used for the simulated provider's narration. Browse more
# with: uv run edge-tts --list-voices

# --- Real AI video-generation provider (GENERATION_PROVIDER=ai) ---
# Generic/vendor-agnostic adapter - point these at your real provider.

# --- Optional LLM-based query validation refinement ---
# When set, this is used (instead of the rule-based keyword heuristic) to
# judge whether a query makes sense and is a STEM topic. Falls back to the
# rule-based check automatically if unset, unreachable, or it errors.
# Defaults to ANTHROPIC_API_KEY if LLM_VALIDATION_API_KEY isn't set.
