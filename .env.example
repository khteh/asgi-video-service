# Copy this file to .env and adjust as needed. All values shown are the
# built-in defaults unless noted otherwise.
#AI_VIDEO_API_KEY=....
# --- Anthropic (only used by the "ai" provider) -------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# --- Optional LLM-based query validation refinement ---
# When set, this is used (instead of the rule-based keyword heuristic) to
# judge whether a query makes sense and is a STEM topic. Falls back to the
# rule-based check automatically if unset, unreachable, or it errors.
# Defaults to ANTHROPIC_API_KEY if LLM_VALIDATION_API_KEY isn't set.
